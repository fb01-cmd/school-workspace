# ─────────────────────────────────────────────────────────────
# 🛠️ 효명고등학교 학적 및 계정 관리 시스템 — 환경변수 템플릿 (.env.example)
# ─────────────────────────────────────────────────────────────
# ⚠️ 주의: 이 파일에는 실제 비밀값/키 값을 절대 적지 마십시오.
# ⚠️ 실제 값은 .env.local 또는 Vercel Environment Variables에 설정합니다.

# 1. Google Workspace Service Account & Admin DWD
GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@hmh.or.kr
GOOGLE_WORKSPACE_SENDER_EMAIL=hmnotice@hmh.or.kr
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 2. Domain & Application URLs
SCHOOL_DOMAIN=hmh.or.kr  # 학교 Google Workspace 주 도메인 (기본값: hmh.or.kr)
NEXT_PUBLIC_APP_URL=https://admin.hmh.or.kr  # 앱 공개 기본 Origin URL (로컬: http://localhost:3000)
NEXT_PUBLIC_BASE_URL=https://admin.hmh.or.kr  # Firebase Auth 리디렉션용 Origin URL

# 3. Firebase Project Settings
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# 4. Cron Security Secret
CRON_SECRET=your_random_cron_secret_token  # Vercel Cron 인증용 비밀토큰

# 5. Gemini AI Engine (Phase 9c/9e 컴시간 시간표/알리미 AI 제안)
# 발급처: Google AI Studio (aistudio.google.com) 또는 GCP Console (플랫폼 소유 계정 fb01@hmh.or.kr로 발급)
GEMINI_API_KEY=your_gemini_api_key

# 6. NEIS Open API (나이스 학사일정 및 주간 시간표 자동 동기화)
# 발급처: 나이스 교육정보 개방 포털 (open.neis.go.kr)
NEIS_API_KEY=your_neis_open_api_key
NEIS_ATPT_CODE=J10  # 시도교육청코드 (예: J10 = 경기도교육청)
NEIS_SCHUL_CODE=7530081  # 행정표준학교고유코드 (예: 7530081 = 효명고등학교)

# 7. Timetable Operations & Cache Control
# 용도: 시간표 그리드/뷰 조회 인메모리 및 Redis 캐시 킬스위치 ('off' 설정 시 캐시 우회 및 실시간 재계산)
TIMETABLE_VIEW_CACHE=on  # 'on' (기본값) 또는 'off' (장애 대응 시 캐시 비활성화)

# 8. Script Execution Controls (CLI Operations)
# 용도: CLI 마이그레이션/정리 스크립트 실행 시 실제 DB/GWS 변경사항 적용 여부 ('1' 지정 시 실제 쓰기 반영, 미지정 시 드라이런)
APPLY=0  # '1' 지정 시 실제 적용, 미지정 또는 '0' 지정 시 드라이런 모드
# 용도: 시트 이관/마이그레이션 스크립트 미리보기 결과 JSON 파일 출력 경로
PREVIEW_OUT=/tmp/discipline_migration_preview.json
