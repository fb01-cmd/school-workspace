rules_version = '2';

// ============================================================================
// 효명고등학교 관리 시스템 — Firestore 보안 규칙 (2026-07-24 Claude 설계 초안)
//
// ⚠️ 적용 순서가 중요합니다. 이 규칙은 "서버 API 라우트의 admin SDK 전환"이
//    완료된 뒤에 적용해야 합니다. 전환 전에 적용하면 서버 라우트(클라이언트 SDK
//    사용 중)가 전부 차단되어 앱이 죽습니다. (project_notes.md 핸드오버 참조)
//
// 설계 원칙:
//   1. 기본 전부 거부(deny-by-default). 아래 명시된 경로만 개방.
//   2. @hmh.or.kr 로그인 계정만 접근 가능 — 일반 Gmail 등 외부 계정은 인증됐어도 차단.
//   3. 학생은 "자기 것"만 읽기. 교직원 화면용 컬렉션은 교직원 역할만.
//   4. 서버 전용 컬렉션(각종 로그)은 클라이언트 쓰기 금지 — admin SDK는 규칙을
//      우회하므로 서버 기록은 영향 없음.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 공통 헬퍼 ──────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    // 학교 도메인 게이트: @hmh.or.kr 검증된 계정만
    function isSchool() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('[^@]+@hmh[.]or[.]kr');
    }
    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // 교직원(교사 또는 수퍼어드민) 여부 — users/{uid}.role 기반
    function isTeacher() {
      return isSchool() && myUserDoc().role in ['teacher', 'super_admin'];
    }
    function isSuperAdmin() {
      return isSchool() && myUserDoc().role == 'super_admin';
    }
    // 문서 키(이메일)가 본인 이메일인지
    function isSelf(email) {
      return isSchool() && request.auth.token.email == email;
    }

    // ── users/{uid} — 계정·역할 정보 ──────────────────────────
    match /users/{uid} {
      // 본인 문서는 본인이, 전체는 교직원이 읽음 (승인 대기 화면 등)
      allow read: if isSchool() && (request.auth.uid == uid || isTeacher());
      // 승인/거절 등 역할 변경은 수퍼어드민만.
      // 예외: 본인이 자기 문서의 isSecurityGroupJoined 플래그 하나만 갱신하는 것은 허용
      //       (RouteGuard의 보안그룹 가입 마킹)
      allow update: if isSuperAdmin()
        || (isSchool() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isSecurityGroupJoined']));
      // 문서 생성(역할 부여)은 서버 전용(/api/auth/sync-user, admin SDK) — 클라이언트가
      // role을 쓸 수 있으면 규칙을 잠가도 권한 상승 통로가 되므로 전면 차단
      allow create, delete: if false;
    }

    // ── settings/{domain} — OU 매핑·졸업 일정 등 도메인 설정 ──
    match /settings/{domain} {
      // 학생 포털도 설정(포털 안내 문구 등)을 읽으므로 학교 구성원 전체 읽기 허용
      allow read: if isSchool();
      // 설정 변경은 교직원 화면(OU 설정, 전출 설정)에서만
      allow write: if isTeacher();
    }

    // ── teacher_profiles/{email} — 확정된 교직원 프로필 ────────
    // ⚠️ 2026-07-25 강화: 확정 프로필은 생활지도 담임 권한의 근거가 되므로
    //    본인 직접 쓰기(isSelf)를 제거 — 변경은 반드시 pending 제출 → 수퍼어드민
    //    승인 경로만 허용 (앱 흐름은 원래부터 승인제였고, 규칙을 그에 맞춰 잠금)
    match /teacher_profiles/{email} {
      allow read: if isTeacher();
      allow write: if isSuperAdmin();
      // 2026-08-13 §11-7 2계층: 비권한 필드(내선번호)만 본인 즉시 수정 허용.
      // affectedKeys().hasOnly()가 소속·직책·담임·부서장을 구조적으로 봉쇄하므로
      // 위 2026-07-25 잠금(권한 근거 필드는 승인 경로만)은 그대로다.
      allow update: if isTeacher()
        && isSelf(email)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['extension', 'updatedAt', 'updatedBy'])
        && request.resource.data.extension is string
        && request.resource.data.extension.size() <= 20
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    // ── teacher_profiles_pending/{email} — 프로필 승인 대기 ────
    match /teacher_profiles_pending/{email} {
      allow read: if isTeacher();
      allow create, update: if isSelf(email) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── graduation_tasks/{domain}/students/{email} — 졸업 예약장부 ──
    match /graduation_tasks/{domain}/students/{email} {
      // 학생은 자기 태스크만 읽음(학생 포털), 교직원은 전체
      allow read: if isSelf(email) || isTeacher();
      // 클라이언트 쓰기는 교직원만 (학생 서명 제출은 서버 API 경유)
      allow write: if isTeacher();
    }

    // ── graduation_consents — 졸업 안내 확인 서명 원본 ─────────
    match /graduation_consents/{consentId} {
      allow read: if isTeacher();
      // 서명 생성은 서버 API에서만 (위조 방지). 클라이언트 쓰기 전면 금지.
      allow write: if false;
    }

    // ── policy_acks — 개인정보 고지 확인 이력 문서 (Phase 11) ─
    // 이력 증빙용 문서. 서버 API에서만 생성/조회 (위조 방지). 클라이언트 전면 차단.
    match /policy_acks/{ackId} {
      allow read, write: if false;
    }

    // ── transfer_out_tasks/{domain}/students/{email} — 전출/자퇴 ──
    match /transfer_out_tasks/{domain}/students/{email} {
      allow read, write: if isTeacher();
    }

    // ── teacher_transfer_tasks/{domain}/teachers/{email} — 교직원 전출 ──
    match /teacher_transfer_tasks/{domain}/teachers/{email} {
      // 전출 당사자 교사는 자기 태스크 읽기 가능(기한 설정 화면)
      allow read: if isSelf(email) || isTeacher();
      allow write: if isTeacher();
    }

    // ── memos/{domain}/items — 쪽지 (docs/memo_spec.md §3) ─────
    // 읽기: **교직원 조직도에 등록된** 교직원 중 발신자·수신자 본인만. 쓰기: 서버 API 전용.
    //
    // 자격 기준이 teacher_profiles 존재인 이유 (2026-08-13 실측으로 정정):
    // 처음엔 users.isApproved == true 를 썼는데, 이 필드는 로그인할 때마다 sync-user가
    // "워크스페이스 관리자인가"로 덮어쓴다 — 일반 교사는 20명 중 0명이 true였고 앞으로도
    // true가 될 수 없어, 쪽지가 수퍼어드민끼리만 쓰이는 기능이 돼 있었다.
    // 실제 "학교 구성원" 판정의 단일 원본은 교직원 조직도(teacher_profiles/{email})다.
    // **소속(departments)이 실제로 있어야 통과한다** — 문서만 있고 소속이 빈 계정(관리자·테스트
    // 계정 등)은 조직도에 이름만 올라 있을 뿐 부서 구성원이 아니다(2026-08-13 사용자 확정).
    // 인프라 계정(fb01 등)은 문서 자체가 없어 앞 조건에서 이미 빠진다.
    match /memos/{domain}/items/{memoId} {
      allow read: if isSchool()
        && myUserDoc().role in ['teacher', 'super_admin']
        && exists(/databases/$(database)/documents/teacher_profiles/$(request.auth.token.email))
        && get(/databases/$(database)/documents/teacher_profiles/$(request.auth.token.email)).data.departments.size() > 0
        && (request.auth.token.email == resource.data.senderEmail
            || request.auth.token.email in resource.data.recipientEmails);
      allow write: if false;
    }

    // 업무 지시 (phase8_tasks_spec §2) — memo와 같은 자격·발신자/수신자 한정. 초안(수신자 0)은 발신자만
    match /tasks/{domain}/items/{taskId} {
      allow read: if isSchool()
        && myUserDoc().role in ['teacher', 'super_admin']
        && exists(/databases/$(database)/documents/teacher_profiles/$(request.auth.token.email))
        && get(/databases/$(database)/documents/teacher_profiles/$(request.auth.token.email)).data.departments.size() > 0
        && (request.auth.token.email == resource.data.senderEmail
            || request.auth.token.email in resource.data.recipientEmails);
      allow write: if false;
    }

    // ── 로그성 컬렉션 — 클라이언트는 읽기만, 조작 금지 ─────────
    // (서버가 admin SDK로 기록하므로 클라이언트 쓰기 불필요.
    //  audit_logs만 예외적으로 클라이언트 create 허용 — 화면에서 직접 기록하는
    //  기존 코드가 있어, 위·변조 위험이 낮은 '추가'만 열어둠. 수정·삭제는 불가.)
    match /audit_logs/{logId} {
      allow read: if isTeacher();
      allow create: if isTeacher();
      allow update, delete: if false;
    }
    match /classroom_cleanup_logs/{logId} {
      allow read: if isTeacher();
      allow write: if false;
    }
    match /classroom_sync_logs/{logId} {
      allow read: if isTeacher();
      allow write: if false;
    }
    match /chrome_bookmark_logs/{logId} {
      allow read: if isTeacher();
      allow write: if false;
    }

    // ── 생활지도 기록 (Phase 6b) — 클라이언트 접근 전면 차단 ───
    // 민감도 최상(징계성 개인정보). 모든 접근은 API 라우트 + admin SDK +
    // 서버 사이드 권한 판정(src/lib/discipline/authz.ts)으로만 한다.
    // 아래 catch-all로도 차단되지만, 실수로 상위에 허용 규칙이 추가되는 것을
    // 막기 위해 명시적으로 잠근다. 이 블록은 절대 열지 말 것.
    match /discipline_config/{domain} {
      allow read, write: if false;
    }
    match /discipline_permissions/{domain}/{document=**} {
      allow read, write: if false;
    }
    match /discipline_records/{domain}/{document=**} {
      allow read, write: if false;
    }
    match /discipline_stage_events/{domain}/{document=**} {
      allow read, write: if false;
    }

    // ── platform_config — 플랫폼 운영 설정 ────────────────────
    // 기본은 잠금(첨부 폴더 캐시·사용량 경보 상태 등은 서버 전용).
    // 예외 1건: 절약 모드 스위치는 로그인 사용자가 **읽기만** 한다 —
    // 클라이언트가 이 문서를 구독해야 켜는 즉시 전 화면에 퍼진다
    // (로그인 시 1회 프리페치로는 이미 접속 중인 교사에게 안 닿아 위급 레버 자격 미달).
    // 쓰기는 언제나 서버(admin SDK) 경유 — /api/ops/saving-mode 가 super_admin을 확인한다.
    match /platform_config/saving_mode {
      allow read: if isSchool();
      allow write: if false;
    }
    match /platform_config/{document=**} {
      allow read, write: if false;
    }

    // ── 그 외 전부 차단 (deny-by-default) ─────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
